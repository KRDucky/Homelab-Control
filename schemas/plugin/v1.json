{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:homelab-control:schema:plugin:v1",
  "title": "HCIS read-only plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "license",
    "contributions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+){1,4}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^<>\\u0000-\\u001f\\u007f\\u202a-\\u202e\\u2066-\\u2069]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "license": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9.+-]{2,40}$"
    },
    "contributions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "overview.sample-card"
        ]
      }
    }
  }
}
