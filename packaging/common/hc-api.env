# Arguments for hc-api. TLS is required unless hc-api only listens on loopback
# behind a TLS-terminating reverse proxy on this host.
#
# Option A: direct TLS
#   HC_API_ARGS=-listen 0.0.0.0:9443 -tls-cert /etc/homelab-control/tls/cert.pem -tls-key /etc/homelab-control/tls/key.pem
# Option B: behind a local reverse proxy (Caddy/Nginx) that terminates TLS
#   HC_API_ARGS=-listen 127.0.0.1:9180 -behind-tls-proxy -allowed-origins https://homelab.example.lan
#
# Optional link to the legacy upstream Webmin UI:
#   add  -legacy-url https://this-host:10000/
HC_API_ARGS=-listen 127.0.0.1:9180 -behind-tls-proxy
