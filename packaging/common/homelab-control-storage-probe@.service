[Unit]
Description=Homelab Control read-only storage probe (M2-4, disabled by default)
Documentation=file:///usr/share/doc/homelab-control/docs/m2/M2-4-DESIGN-REVIEW.md
Requires=homelab-control-storage-probe.socket
After=homelab-control-storage-probe.socket

[Service]
Type=oneshot
ExecStart=/usr/lib/homelab-control/hc-storage-probe
# Closed typed protocol: one Request on stdin, one Result on stdout, then exit.
StandardInput=socket
StandardOutput=socket
StandardError=journal

# O-1 native-probe restrictions (proposal; UNACCEPTED — fail closed).
# Runs as a throwaway unprivileged user with no capabilities and no device
# access: the helper opens no block or char device itself. It is inert until a
# reviewed device-open mechanism (broker fd-passing, or an owner re-decision on
# O-1's device grant) is authorised. No char devices, no DeviceAllow, no
# CAP_SYS_RAWIO, no persistent account.
DynamicUser=yes
PrivateDevices=yes
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@resources @mount @swap @reboot @raw-io @module @obsolete @debug @cpu-emulation @clock
UMask=0077
TimeoutStartSec=30
MemoryMax=64M
TasksMax=16
LimitCORE=0

# No [Install] section: the helper cannot be enabled at boot.
