[Unit]
Description=Homelab Control read-only storage tools (lsblk, smartctl, pvs/lvs)
Documentation=file:///usr/share/doc/homelab-control/docs/m2/M2-4-O1-DEVICE-POLICY.md
Requires=homelab-control-storage-probe.socket
After=homelab-control-storage-probe.socket
# Opt-in marker shipped by the package (owner 2026-11-25); removing it turns the
# helper off without uninstalling anything.
ConditionPathExists=/etc/homelab-control/storage-probe.enabled
# Instances are started only by socket activation, never by hand.
RefuseManualStart=yes

[Service]
Type=oneshot
# No ExecStartPre/ExecStartPost: every Exec line runs inside the helper's SELinux
# domain / AppArmor profile, which deliberately cannot execute grep or a shell.
# Startup fail-closed is therefore the helper's duty (docs/m2/M2-4-O1-DEVICE-POLICY.md,
# "Startup self-check"): DeviceAllow= group names are only added when they are
# listed in /proc/devices at unit start (systemd.resource-control(5)), so the
# helper must read /proc/devices, require EVERY reviewed group below to be
# listed, and otherwise exit non-zero with a typed refusal before probing.
ExecStart=/usr/lib/homelab-control/hc-storage-probe
# Closed typed protocol: one Request on stdin, one Result on stdout, then exit.
StandardInput=socket
StandardOutput=socket
StandardError=journal

# Read-only raw block access for the standard tools (owner 2026-11-25: activate
# the read-only helper; originally O-1, 2026-11-17).
# PrivateDevices=no is necessary: PrivateDevices=yes builds a private /dev that
# cannot contain physical disks, and a static unit cannot bind-mount per-device
# nodes. Read-only access is therefore granted only through the cgroup device
# policy below (eBPF), per reviewed block-device GROUP, with "r" only:
#   sd       SCSI/SATA/SAS and USB-attached storage disks and partitions. The
#            cgroup policy does NOT exclude USB/removable disks: skipping them
#            is helper behaviour only and does not constrain a compromised helper.
#   blkext   NVMe namespaces and extended-minor partitions
#   virtblk  virtio-blk disks (virtual machines)
#   md       Linux software RAID arrays
#   device-mapper  LVM logical volumes and opened LUKS volumes, read only for
#            the ext4 superblock (`tune2fs -l`); ext4 on LVM is the Ubuntu
#            default install. A raw read of an opened LUKS volume is a read of
#            plaintext, the same privilege the helper already has on every
#            unencrypted sd/blkext/virtblk disk (M7 review, 2026-11-26).
# No "w" and no "m" on any block device, no char-* groups, no
# loop/nbd/zram/ram/sr/fd/rbd. One explicit node:
#   /dev/zfs rw  the OpenZFS control device. libzfs opens it read-write for
#                every ioctl, including the read-only ones zpool list/status
#                and zfs list use; the helper runs only those (owner
#                2026-11-25, "Activate read-only helper ... /dev/zfs").
# DevicePolicy=closed additionally
# allows only the standard pseudo devices (null, zero, full, random, urandom).
# systemd adds /dev/loop-control, block-loop and block-blkext with rwm when
# RootImage=, MountImages= or ExtensionImages= is set (systemd.exec(5)); the
# guard test bans those keys so blkext can never become writable.
# The cgroup policy is the ONLY write barrier: the block nodes are root:disk
# 0660, so the root owner alone would be allowed to write. ReadOnlyPaths=/dev is not
# a barrier (a read-only mount does not stop writes to device nodes).
# Residual privilege: raw reads of EVERY disk in these classes, including the
# system disk, bypass filesystem permissions. See
# docs/m2/M2-4-O1-DEVICE-POLICY.md.
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=block-sd r
DeviceAllow=block-blkext r
DeviceAllow=block-virtblk r
DeviceAllow=block-md r
DeviceAllow=block-device-mapper r
DeviceAllow=/dev/zfs rw
# Runs as root without capabilities other than CAP_SYS_RAWIO below. LVM's pvs/lvs
# refuse to scan devices as any other user (VM finding 2026-11-25: "Device open
# 8:0 has no path names" under DynamicUser). Root owns the block nodes (root:disk
# 0660), so no CAP_DAC_* is needed; AppArmor and InaccessiblePaths= confine files,
# and the cgroup device policy below keeps every device read-only.
# Two capabilities, both for smartctl:
#   CAP_SYS_RAWIO  SMART pass-through (SG_IO) to SATA/SAS disks on a read-only descriptor.
#   CAP_SYS_ADMIN  the NVMe SMART/Health log and Identify are NVMe admin commands, which the
#                  kernel allows only with CAP_SYS_ADMIN (owner 2026-11-25: "SMART health for
#                  NVMe is important"). Its broad uses stay blocked here: SystemCallFilter denies
#                  @mount @module @swap @reboot @raw-io @clock @debug @cpu-emulation @resources,
#                  RestrictNamespaces/ProtectKernel*/ProtectControlGroups apply, there is no
#                  network, devices are read-only, and AppArmor denies mount and ptrace.
# No CAP_MKNOD, no CAP_DAC_*.
CapabilityBoundingSet=CAP_SYS_RAWIO CAP_SYS_ADMIN
AmbientCapabilities=CAP_SYS_RAWIO CAP_SYS_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateIPC=yes
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@resources @mount @swap @reboot @raw-io @module @obsolete @debug @cpu-emulation @clock
# A denied system call returns EPERM instead of killing a tool with SIGSYS.
SystemCallErrorNumber=EPERM
# Belt and braces: hc-api secrets and state, and the host-shared /dev IPC dirs.
InaccessiblePaths=-/etc/homelab-control -/var/lib/homelab-control -/var/log/homelab-control -/var/log/homelab-control-broker -/dev/shm -/dev/mqueue
UMask=0077
# Mandatory access control. Each setting is ignored on hosts where that LSM is
# not active. Where the LSM is active but the policy is not installed, the
# instance fails to start (fail closed). No unconfined fallback.
SELinuxContext=system_u:system_r:hc_storage_probe_t:s0
AppArmorProfile=hc-storage-probe
TimeoutStartSec=60
MemoryMax=128M
TasksMax=16
LimitCORE=0

# No [Install] section: the helper cannot be enabled at boot.
