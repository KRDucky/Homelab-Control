[Unit]
Description=Homelab Control MergerFS apply socket (opt-in)
# The package ships the marker. Removing it makes this condition fail.
# No Install section: the socket is not enabled at boot.
ConditionPathExists=/etc/homelab-control/mergerfs-apply.enabled

[Socket]
ListenStream=/run/homelab-control/mergerfs-apply.sock
Accept=yes
# More than one: a status read must still answer while a sync is running.
# SnapRAID's own array lock refuses a second sync, scrub or fix.
MaxConnections=4
SocketMode=0600
SocketUser=root
SocketGroup=root
DirectoryMode=0755
RemoveOnStop=yes

# No Install section: the socket is not enabled at boot.
