[Unit]
Description=Homelab Control read-only storage probe socket (M2-4)

[Socket]
ListenStream=/run/homelab-control/storage-probe.sock
Accept=yes
MaxConnections=1
SocketMode=0600
SocketUser=root
SocketGroup=root

# No [Install] section: the socket is not enabled at boot. If explicitly
# started, each accepted connection starts one helper instance. No broker
# caller is wired, and the helper has no device access.
