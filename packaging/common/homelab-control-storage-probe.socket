[Unit]
Description=Homelab Control read-only storage probe socket (M2-4)

[Socket]
ListenStream=/run/homelab-control/storage-probe.sock
Accept=yes
MaxConnections=1
SocketMode=0600
SocketUser=root
SocketGroup=root

# No [Install] section: the socket is not enabled at boot. Each accepted
# connection starts one homelab-control-storage-probe@ instance on demand, only
# for a reviewed storage.read operation.
