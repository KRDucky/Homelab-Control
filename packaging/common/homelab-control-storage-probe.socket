[Unit]
Description=Homelab Control read-only storage probe socket (M2-4)

[Socket]
ListenStream=/run/homelab-control/storage-probe.sock
Accept=no
SocketMode=0600
SocketUser=root
SocketGroup=root

[Install]
# Deliberately not enabled at boot. The broker activates the helper on demand
# only for individually registered storage.read operations.
