[Unit]
Description=Homelab Control read-only storage tools socket
Documentation=file:///usr/share/doc/homelab-control/docs/m2/M2-4-O1-DEVICE-POLICY.md
# Opt-in marker shipped by the package; remove it to turn the helper off.
ConditionPathExists=/etc/homelab-control/storage-probe.enabled

[Socket]
ListenStream=/run/homelab-control/storage-probe.sock
Accept=yes
MaxConnections=1
SocketMode=0600
SocketUser=root
SocketGroup=root
DirectoryMode=0755
RemoveOnStop=yes

# The package does not enable the socket. An administrator enables it with
#   systemctl enable --now homelab-control-storage-probe.socket
# Each accepted connection starts one helper instance.
[Install]
WantedBy=sockets.target
