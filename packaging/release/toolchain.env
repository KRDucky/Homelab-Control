# Exact toolchain for release builds (ADR 0009 R6). Read by .github/workflows/release-build.yml
# (CI dry run and the release workflow) and checked against RELEASE-BUILDINFO by
# scripts/release-tool.py. Change these only in a reviewed PR; the release dry run on that PR then
# proves the new toolchain still reproduces. Each version must be obtainable by actions/setup-go and
# actions/setup-node (their version manifests, or setup-go's fallback download from go.dev);
# NPM_VERSION must be the npm bundled with NODE_VERSION. GO_VERSION must equal the go-version in
# .github/workflows/ci.yml (checked by tests/release/test_workflow_policy.py).
# 2026-10-21: Go 1.26.9 -> 1.26.10 for GO-2026-6809 / CVE-2026-111943 (crypto/x509).
GO_VERSION=1.26.10
NODE_VERSION=22.23.3
NPM_VERSION=10.9.9
