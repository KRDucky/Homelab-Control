#
# AppArmor profile for the read-only storage tools helper (lsblk, smartctl,
# pvs/lvs --readonly).
#
# STATUS: see docs/evidence/m5/STORAGE-TOOLS.md for the VMs it was exercised on in
# enforce mode. The package installs
# this file but does not load it; Debian's apparmor.service loads it at boot or
# an administrator loads it by hand. The unit sets AppArmorProfile=hc-storage-probe,
# so on a host where AppArmor is active and this profile is not loaded the
# instance cannot start (fail closed).
#
# Network: the helper talks only over the inherited AF_UNIX connection from
# systemd. A blanket "deny network," also matches AF_UNIX and overrides the
# unix rule below (audit: operation=recvmsg class=net family=unix), so the helper
# could not read its request and silently failed. Every other family is denied
# per family; an unlisted family is denied by default as well.
#
# Narrower than the unit's DeviceAllow= on purpose: the device rules below
# name node patterns, read-only. Every unlisted access is denied.

#include <tunables/global>

profile hc-storage-probe /usr/lib/homelab-control/hc-storage-probe flags=(enforce) {
  #include <abstractions/base>

  # Two capabilities, both for smartctl: SG_IO pass-through to SATA/SAS disks
  # (sys_rawio) and NVMe admin commands for the SMART/Health log (sys_admin).
  # No mounts, no tracing, and no network except the inherited AF_UNIX
  # connection (see the unix rule below).
  capability sys_rawio,
  capability sys_admin,
  deny network inet,
  deny network inet6,
  deny network netlink,
  deny network packet,
  deny network bluetooth,
  deny network vsock,
  deny mount,
  deny umount,
  deny pivot_root,
  deny ptrace,

  # The helper and its fixed child tools run inside this profile (ix). pvs and
  # lvs are symlinks to lvm.
  /usr/lib/homelab-control/hc-storage-probe mr,
  /{usr/,}{s,}bin/lsblk ix,
  /{usr/,}{s,}bin/smartctl ix,
  /{usr/,}{s,}bin/{lvm,pvs,lvs} ix,
  /{usr/,}{s,}bin/{zpool,zfs} ix,
  /{usr/,}{s,}bin/btrfs ix,
  # btrfs-progs opens a mounted filesystem's mountpoint (a directory chosen by
  # the helper from its own mountinfo) for its read-only ioctls: directories
  # only, never file contents.
  /**/ r,
  # btrfs scrub status reads the state btrfs-progs saves per filesystem and
  # takes an exclusive lock on it, which AppArmor counts as "w". The unit's
  # ProtectSystem=strict keeps /var/lib read-only, so nothing can be written.
  /var/lib/btrfs/ r,
  /var/lib/btrfs/scrub.status.* rwk,
  # OpenZFS: libzfs opens the control node read-write for its ioctls; the
  # helper runs only zpool list/status and zfs list.
  /dev/zfs rw,
  /etc/zfs/** r,
  /etc/hostid r,
  @{PROC}/sys/kernel/spl/hostid r,
  /etc/blkid.conf r,
  /etc/lvm/** r,
  /usr/share/smartmontools/** r,
  /var/lib/smartmontools/** r,
  /etc/smartmontools/** r,
  /etc/smartd.conf r,
  # udev database: lsblk reads FSTYPE/UUID/serials from here, not the disk.
  /run/udev/data/* r,
  /run/udev/control r,
  # LVM reads its device hints cache; it may try to refresh hint and lock files,
  # which --readonly --nolocking needs neither of.
  /run/lvm/ r,
  /run/lvm/** r,
  deny /run/lvm/** wk,
  deny /run/lock/lvm/** wk,

  # Read-only raw block access, same classes as the unit: sd, NVMe (blkext),
  # virtio-blk, md. No write, no lock, no mmap-exec on any device node.
  /dev/sd[a-z]* r,
  /dev/nvme[0-9]*n[0-9]* r,
  /dev/vd[a-z]* r,
  /dev/md[0-9]* r,
  /dev/md/* r,
  /dev/block/ r,
  /dev/block/[0-9]*:[0-9]* r,
  /dev/disk/ r,
  /dev/disk/** r,
  # LVM's device cache lists /dev and its subdirectories (names only).
  /dev/ r,
  /dev/**/ r,
  /etc/multipath.conf r,
  /etc/multipath/** r,
  /dev/bsg/ r,
  /dev/bsg/* r,

  # Topology and kernel state, read-only. LVM 2.03.11 (Ubuntu 22.04) lists
  # /sys/class and /sys/bus to build its device cache; the Go runtime reads
  # transparent_hugepage settings.
  /sys/ r,
  /sys/** r,
  @{PROC}/devices r,
  @{PROC}/partitions r,
  @{PROC}/filesystems r,
  @{PROC}/swaps r,
  @{PROC}/cmdline r,
  @{PROC}/@{pid}/mountinfo r,
  @{PROC}/@{pid}/mounts r,
  @{PROC}/@{pid}/cgroup r,
  @{PROC}/@{pid}/stat r,
  @{PROC}/@{pid}/fd/ r,
  @{PROC}/@{pid}/cmdline r,

  # The connection from systemd is an inherited descriptor.
  unix (receive, send, getattr, shutdown) type=stream,

  # hc-api secrets and state are never reachable (defence in depth).
  deny /etc/homelab-control/** rwklmx,
  deny /var/lib/homelab-control/** rwklmx,
  deny /var/log/homelab-control{,-broker}/** rwklmx,
}
