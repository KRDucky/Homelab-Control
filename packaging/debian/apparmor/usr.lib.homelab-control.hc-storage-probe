#
# AppArmor profile for the M2-4 O-1 read-only storage probe.
#
# STATUS: unvalidated. It has not been parsed here (no apparmor_parser). Run
# `apparmor_parser -Q -T -r` on it in a disposable validation VM first. The
# package installs this file but does not load it; it is loaded at boot or by
# hand. The unit sets AppArmorProfile=hc-storage-probe, so on a host where
# AppArmor is active and this profile is not loaded the instance cannot start
# (fail closed).
#
# Narrower than the unit's DeviceAllow= on purpose: the device rules below
# name node patterns, read-only. Every unlisted access is denied.

#include <tunables/global>

profile hc-storage-probe /usr/lib/homelab-control/hc-storage-probe flags=(enforce) {
  #include <abstractions/base>

  # Nothing privileged, no network, no mounts, no tracing.
  deny capability,
  deny network,
  deny mount,
  deny umount,
  deny pivot_root,
  deny ptrace,

  # The helper, and the fixed child tools run inside this profile (ix).
  /usr/lib/homelab-control/hc-storage-probe mr,
  /{usr/,}{s,}bin/lvm ix,
  /{usr/,}{s,}bin/blkid ix,
  /etc/blkid.conf r,

  # Read-only raw block access, same classes as the unit: sd, NVMe (blkext),
  # virtio-blk, md. No write, no lock, no mmap-exec on any device node.
  /dev/sd[a-z]* r,
  /dev/nvme[0-9]*n[0-9]* r,
  /dev/vd[a-z]* r,
  /dev/md[0-9]* r,
  /dev/md/* r,
  /dev/block/ r,
  /dev/block/[0-9]*:[0-9]* r,
  /dev/disk/ r,
  /dev/disk/** r,

  # Topology and kernel state, read-only.
  /sys/block/ r,
  /sys/block/** r,
  /sys/class/block/ r,
  /sys/class/block/** r,
  /sys/dev/block/ r,
  /sys/dev/block/** r,
  /sys/devices/** r,
  @{PROC}/devices r,
  @{PROC}/partitions r,
  @{PROC}/filesystems r,
  @{PROC}/@{pid}/mountinfo r,

  # Private LVM_SYSTEM_DIR under the unit's PrivateTmp.
  owner /tmp/hc-storage-probe-lvm-*/ rw,
  owner /tmp/hc-storage-probe-lvm-*/** rwk,

  # The connection from systemd is an inherited descriptor.
  unix (receive, send, getattr, shutdown) type=stream,

  # hc-api secrets and state are never reachable (defence in depth).
  deny /etc/homelab-control/** rwklmx,
  deny /var/lib/homelab-control/** rwklmx,
  deny /var/log/homelab-control{,-broker}/** rwklmx,
}
